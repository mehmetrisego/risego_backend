# ===========================================
# RiseGo Backend - Ortam Değişkenleri Şablonu
# ===========================================
# Bu dosyayı .env olarak kopyalayın ve değerleri doldurun:
#   cp .env.example .env
#
# .env dosyası asla GitHub'a push edilmemelidir!

# ---------- Yandex Fleet — çoklu park (önerilen) ----------
# YANDEX_PARK_N_* (N=1,2,3...) — PARTNER_ID boş kalana kadar devam eder.
# Şirket / park kimliği (UUID) = YANDEX_PARK_N_PARTNER_ID (kodda partnerId)
# X-Client-ID = YANDEX_PARK_N_CLIENT_ID (genelde taxi/park/<PARTNER_ID>; boşsa otomatik üretilir)
# YANDEX_PARK_N_NAME: sürücü girişinde seçilen şehir ve şehir bazlı kampanya ile eşleşmeli (ör. İzmir, Ankara).
# YANDEX_PARK_N_NAME=İzmir
# YANDEX_PARK_N_PARTNER_ID=your_park_uuid
# YANDEX_PARK_N_CLIENT_ID=taxi/park/your_park_uuid
# YANDEX_PARK_N_API_KEY=your_api_key

# Örnek İstanbul Eklenmesi:
# YANDEX_PARK_6_NAME=İstanbul
# YANDEX_PARK_6_PARTNER_ID=00398410b5064b118ffa711e59a759b4
# YANDEX_PARK_6_CLIENT_ID=taxi/park/00398410b5064b118ffa711e59a759b4
# YANDEX_PARK_6_API_KEY=your_api_key_here

# ---------- Yandex Fleet — tek park (eski yöntem) ----------
# YANDEX_PARK_1_* tanımlı değilse bunlar kullanılır (ve isteğe bağlı YANDEX_ADANA_*)
# YANDEX_CLIENT_ID=taxi/park/YOUR_PARK_ID
# YANDEX_API_KEY=YOUR_API_KEY
# YANDEX_PARTNER_ID=YOUR_PARK_ID

# Ana park görünen adı (yalnızca eski YANDEX_* + ADANA modunda)
# YANDEX_PARK_NAME=İzmir

# İkinci park — Adana (yalnızca indeksli YANDEX_PARK_* kullanılmıyorsa)
# YANDEX_ADANA_PARTNER_ID=
# YANDEX_ADANA_CLIENT_ID=
# YANDEX_ADANA_API_KEY=
# YANDEX_ADANA_NAME=Adana

# Yandex çalışma kuralı ID (opsiyonel - yoksa API'den otomatik alınır)
# YANDEX_WORK_RULE_ID=your_work_rule_id

# Sunucu portu (opsiyonel - varsayılan: 3000)
# Railway otomatik PORT atar, local'de 3000 kullanılır
PORT=3000

# PostgreSQL (Railway: Postgres → Variables)
# Yerel makineden bağlanırken DATABASE_PUBLIC_URL kullanın (internal postgres.railway.internal localhost’tan çalışmaz).
# DATABASE_URL=postgresql://...   # Railway içi veya genel
# DATABASE_PUBLIC_URL=postgresql://postgres:ŞİFRE@xxxx.proxy.rlwy.net:PORT/railway

# NetGSM OTP SMS API (giriş doğrulama için)
# https://www.netgsm.com.tr/dokuman/#otp-sms
NETGSM_USERNAME=YOUR_NETGSM_USERNAME
NETGSM_USERCODE=YOUR_NETGSM_USERCODE
NETGSM_MSGHEADER=RISE LTD
